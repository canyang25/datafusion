# ORDER BY a column that is only present as a cast in the select list.
# https://github.com/apache/datafusion/issues/13558

statement ok
CREATE TABLE foo(column1 INT) AS VALUES (10), (2), (3);

# The cast's output name is column1, so ORDER BY column1 sorts that text.
query T
SELECT cast(column1 AS VARCHAR) FROM foo ORDER BY column1;
----
10
2
3

# An explicit alias does not take the input column's name, so ORDER BY
# still sees the integer.
query T
SELECT cast(column1 AS VARCHAR) AS c FROM foo ORDER BY column1;
----
2
3
10

statement ok
DROP TABLE foo;
